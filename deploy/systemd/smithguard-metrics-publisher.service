[Unit]
Description=Publish the complete SmithGuard fail-closed CloudWatch metric batch
After=network-online.target smithguard-health.service
Wants=network-online.target smithguard-health.service

[Service]
Type=oneshot
User=smithguard-telemetry
Group=smithguard-telemetry
SupplementaryGroups=smithguard-ops-read
EnvironmentFile=/etc/SmithGuard/env/metrics.env
WorkingDirectory=/opt/SmithGuard/current
ExecStart=/opt/SmithGuard/current/app/.venv/bin/smithguard-publish-metrics
TimeoutStartSec=120s
UMask=0027
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadOnlyPaths=/var/lib/smithguard/health
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=fd00:ec2::254/128
