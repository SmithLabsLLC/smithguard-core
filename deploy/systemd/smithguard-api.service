[Unit]
Description=SmithGuard public read-only API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
ConditionPathIsSymbolicLink=/opt/SmithGuard/current
ConditionPathExists=/etc/SmithGuard/env/api.env

[Service]
Type=simple
User=smithguard-api
Group=smithguard-proxy
SupplementaryGroups=smithguard-api
EnvironmentFile=/etc/SmithGuard/env/api.env
LoadCredential=snapshot-signing.key:/etc/SmithGuard/credentials/api/snapshot-signing.key
LoadCredential=anonymous-quota.secret:/etc/SmithGuard/credentials/api/anonymous-quota.secret
Environment=SMITHGUARD_SIGNING_KEY_FILE=%d/snapshot-signing.key
Environment=SMITHGUARD_QUOTA_SECRET_FILE=%d/anonymous-quota.secret
Environment=SMITHGUARD_SNAPSHOT_ROOT=/var/lib/smithguard/snapshots
Environment=SMITHGUARD_ANONYMOUS_QUOTA_PATH=/var/lib/smithguard/anonymous-access/quota.sqlite3
Environment=SMITHGUARD_API_PRESSURE_PATH=/var/lib/smithguard/api-health/latest.json
WorkingDirectory=/opt/SmithGuard/current
RuntimeDirectory=smithguard-api
RuntimeDirectoryMode=0750
ExecStart=/opt/SmithGuard/current/app/.venv/bin/smithguard-api
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=yes
RemoveIPC=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/smithguard/snapshots /var/lib/smithguard/anonymous-access /var/lib/smithguard/api-health
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
