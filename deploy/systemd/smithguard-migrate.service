[Unit]
Description=SmithGuard owner-approved database migration
After=postgresql.service
Requires=postgresql.service
ConditionPathIsSymbolicLink=/opt/SmithGuard/current
ConditionPathExists=/etc/SmithGuard/env/maintenance.env

[Service]
Type=oneshot
User=smithguard-maintenance
Group=smithguard-maintenance
EnvironmentFile=/etc/SmithGuard/env/maintenance.env
WorkingDirectory=/opt/SmithGuard/current/app
ExecStart=/opt/SmithGuard/current/app/.venv/bin/smithguard-migrate
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
