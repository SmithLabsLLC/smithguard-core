# Non-secret private operational-health configuration.
SMITHGUARD_DATABASE_URL=postgresql+psycopg://smithguard-health@/smithguard?host=/run/postgresql
SMITHGUARD_BASE_URL=https://api.smithguard.io
SMITHGUARD_HEALTH_REPORT_PATH=/var/lib/smithguard/health/latest.json
SMITHGUARD_METRIC_RECEIPT_PATH=/var/lib/smithguard/health/metrics-latest.json
SMITHGUARD_WARNING_LANE_METRIC_RECEIPT_PATH=/var/lib/smithguard/health/warning-lane-metrics-latest.json
SMITHGUARD_DISK_PATH=/var/lib/smithguard
SMITHGUARD_SPEND_POLICY_PATH=/etc/SmithGuard/policies/xai-spend-policy.shadow.json
SMITHGUARD_RIGHTS_REGISTER_PATH=/opt/SmithGuard/current/contracts/v1/source-rights-register.json
SMITHGUARD_GOVERNANCE_POLICY_PATH=/opt/SmithGuard/current/contracts/v1/source-governance-policy.json
# Select catalog only after its healthy receipt and reviewed handover.
SMITHGUARD_OPENSSF_MONITOR_SOURCE=shadow
SMITHGUARD_OPENSSF_MONITOR_RECEIPT_PATH=/var/lib/smithguard/openssf-health/latest.json
SMITHGUARD_OPENSSF_SCHEDULE_EXPECTED=0
SMITHGUARD_OPENSSF_CATALOG_SCHEDULE_EXPECTED=0
SMITHGUARD_WARNING_LANE_SCHEDULE_EXPECTED=0

# Mirrored defense; the root-owned warning-dispatch.json is authoritative.
SMITHGUARD_WARNING_DISPATCH_ENABLED=0
