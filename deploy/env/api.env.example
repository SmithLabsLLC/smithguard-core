# Non-secret public API configuration.
SMITHGUARD_DATABASE_URL=postgresql+psycopg://smithguard-api@/smithguard?host=/run/postgresql
SMITHGUARD_BASE_URL=https://api.smithguard.io
SMITHGUARD_UNIX_SOCKET=/run/smithguard-api/api.sock
SMITHGUARD_ANONYMOUS_QUOTA_PATH=/var/lib/smithguard/anonymous-access/quota.sqlite3
SMITHGUARD_REVOKED_PUBLIC_KEY_IDS=
SMITHGUARD_RIGHTS_REGISTER_PATH=/opt/SmithGuard/current/contracts/v1/source-rights-register.json
SMITHGUARD_GOVERNANCE_POLICY_PATH=/opt/SmithGuard/current/contracts/v1/source-governance-policy.json
# SMITHGUARD_BIND_HOST=127.0.0.1
# SMITHGUARD_BIND_PORT=8771

# Separate lead feed; activation requires the reviewed policy named in the runbook.
SMITHGUARD_EMERGING_LEADS_PUBLICATION=disabled
