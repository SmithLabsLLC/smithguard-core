# Non-secret CloudWatch metric publication configuration.
# The publisher also constructs this exact safe AWS environment in code so an
# inherited access key, profile, endpoint override, or pager cannot replace it.
AWS_CONFIG_FILE=/nonexistent/smithguard-telemetry-config
AWS_SHARED_CREDENTIALS_FILE=/nonexistent/smithguard-telemetry-credentials
AWS_EC2_METADATA_V1_DISABLED=true
AWS_MAX_ATTEMPTS=2
AWS_METADATA_SERVICE_NUM_ATTEMPTS=2
AWS_METADATA_SERVICE_TIMEOUT=2
AWS_PAGER=
AWS_REGION=us-east-1
AWS_RETRY_MODE=standard
SMITHGUARD_OPENSSF_SCHEDULE_EXPECTED=0
SMITHGUARD_OPENSSF_CATALOG_SCHEDULE_EXPECTED=0
SMITHGUARD_WARNING_LANE_METRICS_EXPECTED=1
SMITHGUARD_WARNING_LANE_SCHEDULE_EXPECTED=0

# Mirrored defense; the root-owned warning-dispatch.json is authoritative.
SMITHGUARD_WARNING_DISPATCH_ENABLED=0
