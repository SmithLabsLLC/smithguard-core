# Non-secret bounded scheduled-discovery configuration.
SMITHGUARD_DATABASE_URL=postgresql+psycopg://smithguard-signals@/smithguard?host=/run/postgresql
SMITHGUARD_SPEND_POLICY_PATH=/etc/SmithGuard/policies/xai-spend-policy.shadow.json
SMITHGUARD_BASE_URL=https://api.smithguard.io

# Separate lead feed; activation requires the reviewed policy named in the runbook.
SMITHGUARD_EMERGING_LEADS_PUBLICATION=disabled

# Mirrored defense; the root-owned warning-dispatch.json is authoritative.
SMITHGUARD_WARNING_DISPATCH_ENABLED=0
