# Non-secret public collector configuration.
SMITHGUARD_DATABASE_URL=postgresql+psycopg://smithguard-collector@/smithguard?host=/run/postgresql
SMITHGUARD_EVIDENCE_ROOT=/var/lib/smithguard/evidence
SMITHGUARD_RIGHTS_REGISTER_PATH=/opt/SmithGuard/current/contracts/v1/source-rights-register.json
SMITHGUARD_AUTHORITY_POLICY_PATH=/opt/SmithGuard/current/contracts/v1/malware-authority-policy.json
SMITHGUARD_GOVERNANCE_POLICY_PATH=/opt/SmithGuard/current/contracts/v1/source-governance-policy.json
SMITHGUARD_BASE_URL=https://api.smithguard.io
SMITHGUARD_GITHUB_TOKEN_FILE=/etc/SmithGuard/secrets/github-advisory-token
SMITHGUARD_OPENSSF_CATALOG_ROOT=/var/lib/smithguard/advisory-catalog/openssf
