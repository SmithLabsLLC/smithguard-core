{
  "schema_version": "1.0.0",
  "catalog_id": "gbsec:operation-catalog:v1",
  "operation_invariants": {
    "assess_dependency_change": {
      "execution_boundary": "customer_local",
      "delta_producer": "shared_local_inventory_engine",
      "request_definition": "DependencyDelta",
      "snapshot_store": "same_customer_local_store",
      "snapshot_preconditions": [
        "before_snapshot_id_exists",
        "after_snapshot_id_exists",
        "both_snapshots_share_project_scope",
        "submitted_delta_matches_deterministic_recomputation"
      ],
      "precondition_failure": "reject_before_assessment",
      "side_effects": "none"
    },
    "incident_visibility": {
      "internal_statuses": ["internal_candidate", "emerging_unverified"],
      "internal_classification": "internal_control",
      "public_classification": "public",
      "public_operation_filter": "data_classification=public",
      "emerging_operation_filter": "approved minimized preliminary-warning revisions only",
      "preliminary_warning_contract": "PreliminaryWarning",
      "preliminary_warning_initial_review": "named_actor_or_owner_authorized_early_lead_policy",
      "preliminary_warning_lifetime_hours": 12,
      "preliminary_warning_recheck_minutes": 60,
      "preliminary_warning_archive": "append_only",
      "preliminary_warning_action_ceiling": 0
    }
  },
