{
  "$defs": {
    "Affects": {
      "additionalProperties": false,
      "properties": {
        "arch": {
          "items": {
            "$ref": "#/$defs/PublicOriginText"
          },
          "maxItems": 1000,
          "title": "Arch",
          "type": "array"
        },
        "functions": {
          "items": {
            "$ref": "#/$defs/PublicOriginText"
          },
          "maxItems": 1000,
          "title": "Functions",
          "type": "array"
        },
        "os": {
          "items": {
            "$ref": "#/$defs/PublicOriginText"
          },
          "maxItems": 1000,
          "title": "Os",
          "type": "array"
        }
      },
      "required": [
        "arch",
        "os",
        "functions"
      ],
      "title": "Affects",
      "type": "object"
    },
    "Alias": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[ -~]+$",
      "title": "Alias",
      "type": "string"
    },
    "AssessmentSignature": {
      "additionalProperties": false,
      "description": "Ed25519 signature over the canonical JSON of the whole response without this field: keys sorted, no whitespace, non-ASCII escaped as \\uXXXX. Verify with the key at /v1/public-keys/{public_key_id}.json.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization": {
          "const": "smithguard-canonical-json-v1",
          "title": "Canonicalization",
          "type": "string"
        },
        "public_key_id": {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
          "title": "Public Key Id",
          "type": "string"
        },
        "value": {
          "maxLength": 88,
          "minLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "public_key_id",
        "canonicalization",
        "value"
      ],
      "title": "AssessmentSignature",
      "type": "object"
    },
    "AttributionUrl": {
      "format": "uri",
      "minLength": 1,
      "title": "AttributionUrl",
      "type": "string"
    },
    "Classification": {
      "enum": [
        "malicious",
        "compromised",
        "vulnerable"
      ],
      "title": "Classification",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "confirmed",
        "probable",
        "possible",
        "unverified",
        "disputed",
        "unknown"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "ConfirmationStatus": {
      "enum": [
        "unverified",
        "confirmation_candidate",
        "contradiction_candidate",
        "confirmed_elsewhere"
      ],
      "title": "ConfirmationStatus",
      "type": "string"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "attribution_complete": {
          "title": "Attribution Complete",
          "type": "boolean"
        },
        "attribution_urls": {
          "items": {
            "$ref": "#/$defs/AttributionUrl"
          },
          "maxItems": 1000,
          "title": "Attribution Urls",
          "type": "array"
        },
        "license_expression": {
          "$ref": "#/$defs/LicenseExpression"
        },
        "packages": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Packages"
              },
              {
                "$ref": "#/$defs/Packages1"
              }
            ]
          },
          "maxItems": 1000,
          "title": "Packages",
          "type": "array"
        },
        "raw_body_sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Raw Body Sha256",
          "type": "string"
        },
        "reachability": {
          "const": "not_assessed",
          "title": "Reachability",
          "type": "string"
        },
        "reference_urls": {
          "items": {
            "$ref": "#/$defs/ReferenceUrl"
          },
          "maxItems": 1000,
          "title": "Reference Urls",
          "type": "array"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "source_withdrawn_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "raw_body_sha256",
        "review_status",
        "license_expression",
        "attribution_complete",
        "source_withdrawn_at",
        "attribution_urls",
        "packages",
        "reference_urls",
        "reachability"
      ],
      "title": "Context",
      "type": "object"
    },
    "CoverageState": {
