{
  "$defs": {
    "QuarantineReason": {
      "maxLength": 120,
      "minLength": 1,
      "title": "QuarantineReason",
      "type": "string"
    },
    "RightsDecision1": {
      "enum": [
        "approved_public",
        "approved_internal",
        "approved_link_only",
        "quarantined",
        "prohibited"
      ],
      "title": "RightsDecision1",
      "type": "string"
    },
    "StorageState": {
      "enum": [
        "stored_immutable",
        "quarantined",
        "link_only",
        "not_retained"
      ],
      "title": "StorageState",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "byte_count": {
      "maximum": 52428800,
      "minimum": 0,
      "title": "Byte Count",
      "type": "integer"
    },
    "canonical_url": {
      "format": "uri",
      "minLength": 1,
      "title": "Canonical Url",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_classification": {
      "const": "restricted_source",
      "title": "Data Classification",
      "type": "string"
    },
    "id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "raw_evidence",
      "maxLength": 80,
      "minLength": 2,
      "title": "Kind",
      "type": "string"
    },
    "media_type": {
      "maxLength": 200,
      "minLength": 3,
      "title": "Media Type",
      "type": "string"
    },
    "quarantine_reasons": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/QuarantineReason"
          },
          "maxItems": 20,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quarantine Reasons"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "revision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "rights_decision": {
      "$ref": "#/$defs/RightsDecision1"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "source_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "source_modified_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_published_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_record_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Source Record Id",
      "type": "string"
    },
    "storage_state": {
      "$ref": "#/$defs/StorageState"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "schema_version",
    "revision",
    "created_at",
    "updated_at",
    "data_classification",
    "source_id",
    "source_record_id",
    "canonical_url",
    "retrieved_at",
    "sha256",
    "byte_count",
    "media_type",
    "storage_state",
    "rights_decision"
  ],
  "title": "RawEvidence",
  "type": "object"
}
