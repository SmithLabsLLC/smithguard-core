{
  "$defs": {
    "Ecosystem3": {
      "enum": [
        "npm",
        "pypi",
        "github-actions",
        "oci",
        "docker",
        "go",
        "rust",
        "composer",
        "erlang",
        "git",
        "maven",
        "nuget",
        "open-vsx",
        "pub",
        "rubygems",
        "swift",
        "vscode"
      ],
      "title": "Ecosystem3",
      "type": "string"
    },
    "PublicArtifactInput": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "ecosystem": {
          "$ref": "#/$defs/Ecosystem3"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
          "title": "Name",
          "type": "string"
        },
        "public_visibility": {
          "const": "asserted_public",
          "title": "Public Visibility",
          "type": "string"
        },
        "registry_host": {
          "$ref": "#/$defs/RegistryHost"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "ecosystem",
        "registry_host",
        "name",
        "version",
        "digest",
        "public_visibility"
      ],
      "title": "PublicArtifactInput",
      "type": "object"
    },
    "RegistryHost": {
      "enum": [
        "registry.npmjs.org",
        "pypi.org",
        "github.com",
        "docker.io",
        "ghcr.io",
        "public.ecr.aws",
        "quay.io",
        "proxy.golang.org",
        "crates.io",
        "repo.packagist.org",
        "hex.pm",
        "repo1.maven.org",
        "api.nuget.org",
        "open-vsx.org",
        "pub.dev",
        "rubygems.org",
        "swiftpackageindex.com",
        "marketplace.visualstudio.com"
      ],
      "title": "RegistryHost",
      "type": "string"
    },
    "Sha256": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/PublicArtifactInput"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_classification": {
      "const": "public",
      "title": "Data Classification",
      "type": "string"
    },
    "id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "public_artifact_assessment_request",
      "maxLength": 80,
      "minLength": 2,
      "title": "Kind",
      "type": "string"
    },
    "revision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "schema_version",
    "revision",
    "created_at",
    "updated_at",
    "data_classification",
    "artifact"
  ],
  "title": "PublicArtifactAssessmentRequest",
  "type": "object"
}
