{
  "$defs": {
    "Disposition": {
      "enum": [
        "record_only",
        "notify",
        "require_acknowledgement",
        "require_approval",
        "deny"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "Ecosystem5": {
      "enum": [
        "npm",
        "pypi",
        "github-actions",
        "oci",
        "docker",
        "go",
        "rust",
        "unknown"
      ],
      "title": "Ecosystem5",
      "type": "string"
    },
    "LocalArtifactInput": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "ecosystem": {
          "$ref": "#/$defs/Ecosystem5"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "registry_host": {
          "anyOf": [
            {
              "maxLength": 259,
              "pattern": "^[A-Za-z0-9.-]+(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Registry Host"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        }
      },
      "required": [
        "ecosystem",
        "registry_host",
        "name",
        "version",
        "digest",
        "visibility"
      ],
      "title": "LocalArtifactInput",
      "type": "object"
    },
    "ReasonCode1": {
      "maxLength": 120,
      "pattern": "^[a-z0-9_]+$",
      "title": "ReasonCode1",
      "type": "string"
    },
    "RecheckTrigger": {
      "enum": [
        "correction",
        "withdrawal",
        "new_evidence",
        "policy_change",
        "dependency_change",
        "exception_expiry"
      ],
      "title": "RecheckTrigger",
      "type": "string"
    },
    "Sha256": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "StableId": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
      "title": "StableId",
      "type": "string"
    },
    "Visibility": {
      "enum": [
        "verified_public",
        "private",
        "unknown"
      ],
      "title": "Visibility",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact": {
      "$ref": "#/$defs/LocalArtifactInput"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_classification": {
      "const": "customer_local",
      "title": "Data Classification",
      "type": "string"
    },
    "decision_at": {
      "format": "date-time",
      "title": "Decision At",
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/Disposition"
    },
    "exception_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "policy_decision",
      "maxLength": 80,
      "minLength": 2,
      "title": "Kind",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "project_alias": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Project Alias",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode1"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "recheck_triggers": {
      "items": {
        "$ref": "#/$defs/RecheckTrigger"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Recheck Triggers",
      "type": "array"
    },
    "revision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "rule_id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "schema_version",
    "revision",
    "created_at",
    "updated_at",
    "data_classification",
    "policy_version",
    "rule_id",
    "artifact",
    "project_alias",
    "disposition",
    "reason_codes",
    "exception_id",
    "approval_id",
    "decision_at",
    "recheck_triggers"
  ],
  "title": "PolicyDecision",
  "type": "object"
}
