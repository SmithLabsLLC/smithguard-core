        "result": {
          "$ref": "#/$defs/Result"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        }
      },
      "required": [
        "ecosystem",
        "stage",
        "result",
        "as_of"
      ],
      "title": "CoverageState",
      "type": "object"
    },
    "DataClassification10": {
      "enum": [
        "public",
        "internal_control"
      ],
      "title": "DataClassification10",
      "type": "string"
    },
    "Ecosystem": {
      "enum": [
        "npm",
        "pypi",
        "github-actions",
        "oci",
        "docker",
        "go",
        "rust",
        "composer",
        "erlang",
        "git",
        "maven",
        "nuget",
        "open-vsx",
        "pub",
        "rubygems",
        "swift",
        "vscode",
        "unknown"
      ],
      "title": "Ecosystem",
      "type": "string"
    },
    "IncidentStatus": {
      "enum": [
        "internal_candidate",
        "emerging_unverified",
        "investigating",
        "reported",
        "corroborated",
        "confirmed",
        "contained",
        "resolved",
        "disputed",
        "withdrawn",
        "expired"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "PublicStatus": {
      "enum": [
        "reported",
        "corroborated",
        "confirmed",
        "disputed",
        "withdrawn"
      ],
      "title": "PublicStatus",
      "type": "string"
    },
    "Result": {
      "enum": [
        "supported",
        "partial",
        "unsupported",
        "stale",
        "unknown"
      ],
      "title": "Result",
      "type": "string"
    },
    "StableId": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
      "title": "StableId",
      "type": "string"
    },
    "StableIdList": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "maxItems": 10000,
      "title": "StableIdList",
      "type": "array"
    },
    "Stage": {
      "enum": [
        "research",
        "intake",
        "normalized",
        "matched",
        "response-tested"
      ],
      "title": "Stage",
      "type": "string"
    },
    "UnknownListItem": {
      "maxLength": 300,
      "minLength": 1,
      "title": "UnknownListItem",
      "type": "string"
    },
    "UpstreamId": {
      "maxLength": 160,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
      "title": "UpstreamId",
      "type": "string"
    },
    "Uri": {
      "format": "uri",
      "minLength": 1,
      "title": "Uri",
      "type": "string"
    }
