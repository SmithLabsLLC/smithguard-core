        "source_rights_register_id": {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
          "title": "Source Rights Register Id",
          "type": "string"
        },
        "transport_source_id": {
          "maxLength": 160,
          "minLength": 8,
          "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
          "title": "Transport Source Id",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "upstream_ids": {
          "items": {
            "$ref": "#/$defs/UpstreamId"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Upstream Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "schema_version",
        "revision",
        "created_at",
        "updated_at",
        "data_classification",
        "incident_id",
        "claim_id",
        "artifact_id",
        "evidence_ids",
        "public_status",
        "confirmation_method",
        "transport_source_id",
        "assertion_source_id",
        "confirming_authority_id",
        "authority_policy_id",
        "authority_policy_version",
        "authority_rule_id",
        "source_rights_register_id",
        "attribution_policy_version",
        "reason_code",
        "automated",
        "independent_goodboy_analysis",
        "upstream_ids",
        "source_references",
        "exception_required",
        "exception_reason_code",
        "decided_at"
      ],
      "title": "AuthorityDecision",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "confirmed",
        "probable",
        "possible",
        "unverified",
        "disputed",
        "unknown"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "ConfirmationMethod": {
      "enum": [
        "reported_source",
        "automated_source_policy",
        "automated_corroboration",
        "human_review",
        "withdrawal",
        "dispute"
      ],
