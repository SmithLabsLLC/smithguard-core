      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/CoverageState"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_classification": {
      "$ref": "#/$defs/DataClassification10"
    },
    "event_ids": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "maxItems": 10000,
      "title": "Event Ids",
      "type": "array"
    },
    "first_observed_at": {
      "format": "date-time",
      "title": "First Observed At",
      "type": "string"
    },
    "id": {
      "maxLength": 160,
      "minLength": 8,
      "pattern": "^gbsec:[a-z0-9][a-z0-9:._/-]+$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "incident",
      "maxLength": 80,
      "minLength": 2,
      "title": "Kind",
      "type": "string"
    },
    "last_changed_at": {
      "format": "date-time",
      "title": "Last Changed At",
      "type": "string"
    },
    "redirect_to": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
