    "kind",
    "schema_version",
    "revision",
    "created_at",
    "updated_at",
    "data_classification",
    "title",
    "status",
    "confidence",
    "claim_ids",
    "artifact_ids",
    "affected_range_ids",
    "relationship_ids",
    "event_ids",
    "alias_ids",
